# Copy this to .env and fill in your Databricks credentials.
# Load it into your shell with: `set -a && source .env && set +a`

# Databricks workspace host (no protocol). Example: dbc-xxxxxxxx-xxxx.cloud.databricks.com
DBT_DATABRICKS_HOST=

# SQL Warehouse HTTP Path. Example: /sql/1.0/warehouses/abcdef1234567890
DBT_DATABRICKS_HTTP_PATH=

# OAuth M2M credentials for a Databricks service principal.
# Admin console > Service principals > (pick or create SP) > Secrets > Generate secret.
DBT_DATABRICKS_CLIENT_ID=
DBT_DATABRICKS_CLIENT_SECRET=

# Unity Catalog / schemas.
# One catalog (`workspace`) with three schemas: bronze, silver, gold.
DBT_CATALOG=workspace
DBT_BRONZE_SCHEMA=bronze
DBT_SILVER_SCHEMA=silver
DBT_GOLD_SCHEMA=gold
